# Допустимые значения: development, production
RESERVE_SIN_ENV=production

# Допустимые значения: debug, info, warning, error
RESERVE_SIN_LOG_LEVEL=info

# Путь к SQLite. В production используйте /var/lib/reserve-sin/reserve.db.
RESERVE_SIN_DATABASE_PATH=/var/lib/reserve-sin/reserve.db

# Обязательный Bearer-токен. Задайте случайное значение в реальном env-файле.
# RESERVE_SIN_API_TOKEN=
