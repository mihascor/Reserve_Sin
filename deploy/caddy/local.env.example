# This file is a template. Copy it to deploy/caddy/local.env and fill in local-only values.
# Do not commit the copied file or use production credentials here.

# The Go API and Caddy must use the same random local development token.
RESERVE_SIN_API_TOKEN=

# Basic Auth identity for http://127.0.0.1:8443/app/.
RESERVE_SIN_WEB_BASIC_AUTH_USER=

# Generate a bcrypt hash with Caddy and paste it inside single quotes here.
# Quotes keep the $ characters in the hash intact when this file is sourced by the shell.
RESERVE_SIN_WEB_BASIC_AUTH_HASH=''

# Keep the local development database outside the repository, or point to a safe SQLite copy.
RESERVE_SIN_DATABASE_PATH=/tmp/reserve-sin-web-dev.db
